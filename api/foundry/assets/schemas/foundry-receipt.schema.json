{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FoundryReceipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "type",
    "tenant",
    "arbiter_id",
    "counter",
    "ts_ns",
    "epoch",
    "prev",
    "key_id",
    "body",
    "sig"
  ],
  "properties": {
    "schema": {
      "const": "foundry.receipt/v0.1"
    },
    "type": {
      "enum": [
        "session_open",
        "session_close",
        "delegation",
        "permit",
        "escalation",
        "denial",
        "review",
        "policy_approval",
        "test_commitment",
        "bundle_signed",
        "underwriting_packet",
        "attestation_gap"
      ]
    },
    "tenant": {
      "type": "string"
    },
    "arbiter_id": {
      "type": "string"
    },
    "counter": {
      "type": "integer",
      "minimum": 1
    },
    "ts_ns": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "epoch": {
      "type": "integer"
    },
    "prev": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "key_id": {
      "type": "string"
    },
    "body": {
      "type": "object"
    },
    "sig": {
      "type": "string"
    }
  }
}